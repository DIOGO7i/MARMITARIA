# Copie para .env (ou configure no painel da hospedagem). NÃO coloque segredos reais no repositório.

# Porta HTTP do servidor
PORT=3001

# Segredo para assinar as sessões (JWT). Obrigatório em produção.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Pasta onde fica o banco de dados (marmitaria.db). Em produção, use um disco persistente.
# Padrão: server/data dentro do projeto. Use caminho ABSOLUTO se mudar.
# DATA_DIR=/var/lib/marmitaria

# Ative em produção
NODE_ENV=production

# Só necessário se o front-end for servido de OUTRO domínio
# CORS_ORIGIN=https://painel.suamarmitaria.com.br

# Leitura de nota fiscal por FOTO (opcional). Sem esta chave, o XML e a chave bipada continuam funcionando.
# Crie a chave em https://console.anthropic.com (é cobrado por uso; em geral poucos centavos por nota).
# ANTHROPIC_API_KEY=sk-ant-...
# Modelo usado na leitura (opcional)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Endereço público do sistema (usado no link do e-mail de "Esqueci a senha"). Ex.: https://painel.suamarmitaria.com.br
# APP_URL=https://painel.suamarmitaria.com.br
# Defina como 1 quando o sistema estiver atrás do proxy/HTTPS da hospedagem (Railway, Render, Nginx...)
# TRUST_PROXY=1

# "Esqueci a senha" por E-MAIL (opcional). Sem isto, quem instala cria uma senha nova com:  npm run nova-senha -- email senha-nova
# Funciona com qualquer serviço SMTP (Gmail com senha de app, Brevo, Resend, Amazon SES, Zoho...).
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASS=senha-ou-chave
# SMTP_FROM="Marmitaria <nao-responda@suamarmitaria.com.br>"

# Módulos extras (desligados por padrão para o sistema ficar simples). Separe por vírgula.
#   fichas            → fichas técnicas, baixa automática dos ingredientes e alerta de lucro por tamanho
#   estoque_completo  → custo médio, valor em estoque, categorias, fornecedores e tela de saídas detalhada
#   todos             → liga tudo
# MODULOS_EXTRAS=fichas,estoque_completo

# Endereço do cliente (opcional): chave do Google Maps com DUAS APIs ativadas — "Routes API" (distância e frete)
# e "Places API (New)" (sugestões de endereço enquanto digita, já com o bairro). Fica só no servidor.
# Sem a chave, o sistema funciona normal: o endereço é digitado à mão e a distância não aparece.
# Passo a passo no README ("Distância até o cliente").
# GOOGLE_MAPS_API_KEY=AIza...
